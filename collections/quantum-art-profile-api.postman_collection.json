          "name": "Get Api Key",
          "request": {
            "name": "Get Api Key",
            "description": {
              "content": "Get the current user's API key for programmatic access.\n\nReturns the user's API key which can be used with:\n- Qiskit Provider for quantum circuit submission\n- Direct API calls as Bearer token\n- Any programmatic integration\n\nSecurity: Only returns the API key to the authenticated user themselves.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "profile",
                "api-key"
              ],
              "host": [
                "{{baseUrl}}"
