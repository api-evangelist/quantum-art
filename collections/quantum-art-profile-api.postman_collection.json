        {
          "id": "b7d3428c-062f-4d42-b410-ac455a687203",
          "name": "Regenerate Api Key",
          "request": {
            "name": "Regenerate Api Key",
            "description": {
              "content": "Rotate the calling user's API key.\n\nBody: ``{\"expires_in\": \"1d\" | \"2w\" | \"1m\" | \"3m\" | \"6m\"}``.\nGenerates a new ``qaas_<urlsafe>`` token, clears any prior revocation,\nand stamps ``api_key_expires_at = NOW() + interval``. The old key stops\nauthenticating immediately (the row's value is overwritten).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "profile",
                "api-key",
                "regenerate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key_0\": 6003.9863730579\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
