        {
          "id": "c76eb4ad-aa84-4bb5-8f71-54020b3e6c15",
          "name": "Update Profile",
          "request": {
            "name": "Update Profile",
            "description": {
              "content": "Update the calling user's own profile fields.\n\nBody: ``{\"first_name\": str, \"last_name\": str}``.\n\nOnly the name is editable here. Email is the unique login identifier\nand is intentionally NOT mutable through this endpoint (changing it\nwould also require re-verification, which is out of scope).\n``first_name`` must not be blank or whitespace-only; ``last_name`` is\nrequired in the request but may be an empty string.\n\nA fresh access token is returned alongside the updated user so the\nclient can swap its stored JWT in one round-trip — otherwise the old\ntoken's payload would keep claiming the stale name until it expired.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "profile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
